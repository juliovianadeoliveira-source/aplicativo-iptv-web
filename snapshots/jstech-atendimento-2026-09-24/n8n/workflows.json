    "name": "JSTech - Fila Inteligente Evolution API",
    "description": "Fila real de campanhas: Supabase -> lote 20 -> atraso 15-35s -> Evolution API -> confirmação -> loop.",
    "active": true,
    "isArchived": false,
    "nodes": [
      {
        "parameters": {
          "rule": {
            "interval": [
              {
                "field": "cronExpression",
                "expression": "*/15 9-18 * * *"
              }
            ]
          }
        },
        "id": "480aa144-1966-4715-bb8e-9860b7761686",
        "name": "09h-19h a cada 15 min",
        "type": "n8n-nodes-base.scheduleTrigger",
        "typeVersion": 1.4,
        "position": [
          -1080,
          -140
        ]
      },
      {
        "parameters": {},
        "id": "e62b24fe-a252-475f-a180-4a995646d68c",
        "name": "Iniciar manualmente",
        "type": "n8n-nodes-base.manualTrigger",
        "typeVersion": 1,
        "position": [
          -1080,
          80
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://fvttsguxeocisqvcrbqh.supabase.co/functions/v1/jstech-n8n-campaign-queue",
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ JSON.stringify({ action: 'claim', token: $env.N8N_CAMPAIGN_TOKEN, limit: 20 }) }}",
          "options": {}
        },
        "id": "ac3f2f73-f464-4e0a-aaa9-d13c24c793b7",
        "name": "1. Buscar contatos no Supabase",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          -820,
          -40
        ]
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const rows = Array.isArray($json.items) ? $json.items : [];\nreturn rows.map(row => ({ json: row }));"
        },
        "id": "e09843bb-5e40-490a-b63c-1adba1383364",
        "name": "2. Preparar lista",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -580,
          -40
        ]
      },
      {
        "parameters": {
          "batchSize": 20,
          "options": {}
        },
        "id": "d680ec82-e985-44da-9e50-b86cd33fd2c5",
        "name": "3. Lote de 20 contatos",
        "type": "n8n-nodes-base.splitInBatches",
        "typeVersion": 3,
        "position": [
          -340,
          -40
        ]
      },
      {
        "parameters": {
          "batchSize": 1,
          "options": {}
        },
        "id": "2b3c3b41-3eb2-4e44-acaf-e3ef0e5478c6",
        "name": "4. Um contato por vez",
        "type": "n8n-nodes-base.splitInBatches",
        "typeVersion": 3,
        "position": [
          -80,
          100
        ]
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "const minSegundos = 15;\nconst maxSegundos = 35;\nconst tempoAleatorio = Math.floor(Math.random() * (maxSegundos - minSegundos + 1) + minSegundos);\nconst item = $input.item;\nitem.json.delay_seconds = tempoAleatorio;\nreturn item;"
        },
        "id": "504d6ba8-92f7-4afc-8953-3581fca4c441",
        "name": "5. Atraso aleatorio 15-35s",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          180,
          100
        ]
      },
      {
        "parameters": {
          "resume": "timeInterval",
          "amount": "={{ $json.delay_seconds }}",
          "unit": "seconds"
        },
        "id": "b7c237c4-bf48-4cc3-9154-a43db4f278bc",
        "name": "6. Wait inteligente",
        "type": "n8n-nodes-base.wait",
        "typeVersion": 1.1,
        "position": [
          420,
          100
        ],
        "webhookId": "38fb52e1-6e34-4ca6-911f-5f8186746bc1"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "={{ $json.base_url.replace(/\\/+$/, '') + '/message/sendText/' + encodeURIComponent($json.instance_name) }}",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "apikey",
                "value": "={{ $json.api_key }}"
              }
            ]
          },
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ JSON.stringify({ number: $json.phone, text: $json.body }) }}",
          "options": {}
        },
        "id": "4ffbb978-c86c-45b2-a7dd-a4e1b060c29b",
        "name": "7. Enviar pela Evolution API",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          660,
          100
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "const src = $('5. Atraso aleatorio 15-35s').item.json;\nconst r = $json || {};\nconst mid = r?.key?.id ?? r?.data?.key?.id ?? r?.message?.key?.id ?? r?.messages?.[0]?.id ?? null;\nlet err = null;\nif (!mid) {\n  try { err = JSON.stringify(r).slice(0, 700); } catch { err = 'send_failed'; }\n}\nreturn { json: { ...src, send_ok: !!mid, provider_message_id: mid, send_error: err } };"
        },
        "id": "4ec5510d-bf3c-4c86-890e-fe8d3aff9c46",
        "name": "8. Conferir resultado",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          900,
          100
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://fvttsguxeocisqvcrbqh.supabase.co/functions/v1/jstech-n8n-campaign-queue",
          "sendBody": true,
          "contentType": "raw",
          "rawContentType": "application/json",
          "body": "={{ JSON.stringify({ action: 'ack', token: $env.N8N_CAMPAIGN_TOKEN, delivery_id: $json.delivery_id, ok: $json.send_ok, provider_message_id: $json.provider_message_id, error: $json.send_error }) }}",
          "options": {}
        },
        "id": "8589d43a-5991-4aff-a210-d1bcf9f44cdd",
        "name": "9. Confirmar no Supabase",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1140,
          100
        ],
        "onError": "continueRegularOutput"
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "return $input.all();"
        },
        "id": "b6e7146e-965d-4311-b1e8-45deac65271e",
        "name": "10. Lote concluido",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -80,
